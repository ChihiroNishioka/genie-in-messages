     private func releaseRate(chatID: Int64, at: Date) {
         if let index = persisted.rateEvents.lastIndex(where: { $0.chatID == chatID && $0.at == at }) {
             persisted.rateEvents.remove(at: index)
         }
     }
 
     private func pruneRates(now: Date) {
